    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.55.0",
    "@tanstack/react-query": "^5.90.21",
    "expo": "^55.0.0-preview.12",
    "expo-blur": "~55.0.9",
    "expo-clipboard": "~55.0.7",
    "expo-constants": "~55.0.6",
    "expo-contacts": "~55.0.7",
    "expo-dev-client": "~55.0.7",
    "expo-device": "~55.0.10",
    "expo-haptics": "~55.0.8",
